# Backend Environment Variables for F1 Performance Analytics Platform
# Copy this file to backend/.env and fill in your actual values.

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Pinecone API
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=f1-racing
PINECONE_NAMESPACE=f1-2021-2025

# Backend configuration
API_V1_STR=/api/v1
PROJECT_NAME=F1 Performance Analytics

# optional: override embedding model if needed
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384