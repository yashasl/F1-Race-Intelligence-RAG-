__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
secrets/
credentials/

# Local databases and temporary database files
*.sqlite
*.sqlite3
*.db
*.sqlite-wal
*.sqlite-shm
*-wal
*-shm

# Machine learning model weights and checkpoints
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.h5
*.hdf5
*.joblib
*.pkl

