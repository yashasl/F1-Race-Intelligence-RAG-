chroma_db/
vector_db/
vectorstore/
embeddings/
embedding_cache/
.faiss/
*.faiss
*.index

# Local model caches
.cache/
huggingface_cache/
models_cache/

# Frontend build output
dist/
build/
.vite/
coverage/

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Editor and IDE files
.idea/
.vscode/*
